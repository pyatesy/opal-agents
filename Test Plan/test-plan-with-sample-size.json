ential--><div><div class=\"flex items-center justify-between mb-2\"><span class=\"text-sm font-semibold text-base-content\">Potential</span><span class=\"text-lg font-bold text-primary editable-text\" data-editable=\"true\">{{ pie_potential }}</span></div><progress class=\"progress progress-primary w-full\" value=\"{{pie_potential_progress}}\" max=\"100\"></progress><p class=\"text-xs text-base-content/60 mt-1 editable-text\" data-editable=\"true\">{{ pie_potential_description }}</p></div><!--Impact--><div><div class=\"flex items-center justify-between mb-2\"><span class=\"text-sm font-semibold text-base-content\">Impact</span><span class=\"text-lg font-bold text-secondary editable-text\" data-editable=\"true\">{{ pie_impact }}</span></div><progress class=\"progress progress-secondary w-full\" value=\"{{pie_impact_progress}}\" max=\"100\"></progress><p class=\"text-xs text-base-content/60 mt-1 editable-text\" data-editable=\"true\">{{ pie_impact_description }}</p></div><!--Ease--><div><div class=\"flex items-center justify-between mb-2\"><span class=\"text-sm font-semibold text-base-content\">Ease</span><span class=\"text-lg font-bold text-accent editable-text\" data-editable=\"true\">{{ pie_ease }}</span></div><progress class=\"progress progress-accent w-full\" value=\"{{pie_ease_progress}}\" max=\"100\"></progress><p class=\"text-xs text-base-content/60 mt-1 editable-text\" data-editable=\"true\">{{ pie_ease_description }}</p></div><div class=\"divider my-2\"></div><!--Calculation--><div class=\"bg-base-200 rounded-lg p-3 border border-base-300\"><div class=\"flex items-center justify-between\"><span class=\"text-sm font-semibold\">Score</span><span class=\"text-2xl font-bold text-primary editable-text\" data-editable=\"true\">{{ pie_score }}</span></div><p class=\"text-xs text-base-content/60 mt-1 editable-text\" data-editable=\"true\">{{ pie_score_formula }}</p></div></div></div></div><!--Audience--><div class=\"card bg-base-100 shadow-xl\"><div class=\"card-body\"><h2 class=\"card-title text-xl mb-2\"><svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>Target Audience</h2><div class=\"text-base-content/80 editable-text\" data-editable=\"true\">{{ target_audience }}</div></div></div><!--Risk and Assumptions--><div class=\"card bg-base-100 shadow-xl\"><div class=\"card-body\"><h2 class=\"card-title text-xl mb-3\"><svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"></path></svg>Risk and Assumptions</h2><div class=\"space-y-3\"><div><h3 class=\"font-semibold text-sm mb-2 text-warning\">Risks</h3><ul class=\"space-y-2 text-sm text-base-content/80\"><li class=\"flex items-start gap-2\"><span class=\"text-warning mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ risk_1 }}</span></li><li class=\"flex items-start gap-2\"><span class=\"text-warning mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ risk_2 }}</span></li><li class=\"flex items-start gap-2\"><span class=\"text-warning mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ risk_3 }}</span></li></ul></div><div class=\"divider my-2\"></div><div><h3 class=\"font-semibold text-sm mb-2\">Assumptions</h3><ul class=\"space-y-2 text-sm text-base-content/80\"><li class=\"flex items-start gap-2\"><span class=\"text-primary mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ assumption_1 }}</span></li><li class=\"flex items-start gap-2\"><span class=\"text-primary mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ assumption_2 }}</span></li><li class=\"flex items-start gap-2\"><span class=\"text-primary mt-1\">•</span><span class=\"editable-text\" data-editable=\"true\">{{ assumption_3 }}</span></li></ul></div></div></div></div><!--Implementation Notes--><div class=\"card bg-base-100 shadow-xl\"><div class=\"card-body\"><h2 class=\"card-title text-xl mb-3\"><svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\"></path></svg>Implementation Notes</h2><div class=\"space-y-3 text-sm text-base-content/80\"><div><div class=\"font-semibold mb-1 text-base-content editable-text\" data-editable=\"true\">{{ implementation_note_1_title }}</div><p class=\"editable-text\" data-editable=\"true\">{{ implementation_note_1_content }}</p></div><div><div class=\"font-semibold mb-1 text-base-content editable-text\" data-editable=\"true\">{{ implementation_note_2_title }}</div><p class=\"editable-text\" data-editable=\"true\">{{ implementation_note_2_content }}</p></div><div><div class=\"font-semibold mb-1 text-base-content editable-text\" data-editable=\"true\">{{ implementation_note_3_title }}</div><p class=\"editable-text\" data-editable=\"true\">{{ implementation_note_3_content }}</p></div></div></div></div></div></div></div><script>document.addEventListener('DOMContentLoaded',function(){const STORAGE_PREFIX='experiment-plan-';function getStorageKey(element){const id=element.getAttribute('data-storage-id')||element.getAttribute('id')||element.className.split(' ').find(c=>c.startsWith('storage-'))?.replace('storage-','');if(!id){const path=[];let current=element;while(current&&current!==document.body){const parent=current.parentElement;const siblings=Array.from(parent.children);const index=siblings.indexOf(current);path.unshift(`${current.tagName.toLowerCase()}:${index}`);current=parent}return STORAGE_PREFIX+path.join('-')}return STORAGE_PREFIX+id}function saveTextContent(element,text){const key=getStorageKey(element);localStorage.setItem(key,text)}function loadTextContent(element){const key=getStorageKey(element);const saved=localStorage.getItem(key);if(saved){element.textContent=saved}}function assignStorageIds(){const editableElements=document.querySelectorAll('.editable-text[data-editable=\"true\"]');editableElements.forEach((element,index)=>{if(!element.getAttribute('data-storage-id')){const text=element.textContent.trim();let identifier='text-'+index;const parent=element.parentElement;const parentText=parent?parent.textContent.trim().substring(0,30):'';identifier=parentText.replace(/\\s+/g,'-').toLowerCase().substring(0,20)+'-'+index;element.setAttribute('data-storage-id',identifier)}})}function restoreSavedContent(){assignStorageIds();const editableElements=document.querySelectorAll('.editable-text[data-editable=\"true\"]');editableElements.forEach(element=>{loadTextContent(element)})}restoreSavedContent();const editableElements=document.querySelectorAll('.editable-text[data-editable=\"true\"]');editableElements.forEach((element,index)=>{if(!element.getAttribute('data-storage-id')){assignStorageIds()}element.addEventListener('click',function(e){e.stopPropagation();if(element.querySelector('.edit-input')){return}const originalText=element.textContent.trim();const originalStyles=window.getComputedStyle(element);const container=document.createElement('div');container.className='editing-container';const isMultiLine=originalText.length>50||element.tagName==='P'||element.tagName==='LI'||element.tagName==='TD';const input=document.createElement(isMultiLine?'textarea':'input');input.type='text';input.className='edit-input';input.value=originalText;input.style.fontSize=originalStyles.fontSize;input.style.fontWeight=originalStyles.fontWeight;input.style.color=originalStyles.color;input.style.fontFamily=originalStyles.fontFamily;if(isMultiLine){input.style.minHeight='60px'}const doneButton=document.createElement('button');doneButton.className='edit-button';doneButton.textContent='Done';const parent=element.parentNode;element.style.display='none';container.appendChild(input);container.appendChild(doneButton);parent.insertBefore(container,element);input.focus();if(!isMultiLine){input.select()}doneButton.addEventListener('click',function(){const newText=input.value.trim();element.textContent=newText||originalText;element.style.display='';saveTextContent(element,newText||originalText);container.remove()});input.addEventListener('keydown',function(e){if(!isMultiLine&&e.key==='Enter'&&!e.shiftKey){e.preventDefault();doneButton.click()}else if(isMultiLine&&e.key==='Enter'&&(e.ctrlKey||e.metaKey)){e.preventDefault();doneButton.click()}else if(e.key==='Escape'){element.style.display='';container.remove()}});setTimeout(()=>{const handleOutsideClick=function(e){if(!container.contains(e.target)&&!element.contains(e.target)){element.style.display='';container.remove();document.removeEventListener('click',handleOutsideClick)}};document.addEventListener('click',handleOutsideClick)},100)})});function saveCheckboxState(checkboxId,checked){const key=STORAGE_PREFIX+'checkbox-'+checkboxId;localStorage.setItem(key,checked?'true':'false')}function loadCheckboxState(checkboxId){const key=STORAGE_PREFIX+'checkbox-'+checkboxId;const saved=localStorage.getItem(key);if(saved!==null){return saved==='true'}return null}function restoreCheckboxStates(){const checkboxes=document.querySelectorAll('.editable-checkbox');checkboxes.forEach(checkbox=>{const checkboxId=checkbox.getAttribute('data-checkbox-id')||checkbox.id;if(checkboxId){const savedState=loadCheckboxState(checkboxId);if(savedState!==null){checkbox.checked=savedState}}})}function initializeCheckboxes(){const checkboxes=document.querySelectorAll('.editable-checkbox');checkboxes.forEach(checkbox=>{checkbox.addEventListener('change',function(){const checkboxId=this.getAttribute('data-checkbox-id')||this.id;if(checkboxId){saveCheckboxState(checkboxId,this.checked)}})})}restoreCheckboxStates();initializeCheckboxes()})</script></body></html>\n```\n\n## Refinement (R)\n\n- Take pride in your work. Ensure you have applied the assumptions labelling where assumptions have been taken.\n\n- Use HTML to correctly format the output to follow the brand guidelines for colors (not spacing) use the Brand Guidelines: Colors &amp; Look and Feel",
